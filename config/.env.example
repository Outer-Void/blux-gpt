# ============================================================
# BluxGPT Configuration
# User config: ~/.config/bluxgpt/.env
# Never commit this file
# ============================================================

# --- Locked model stack ---
BLUXGPT_DEFAULT_MODEL=gpt-5-mini
BLUXGPT_CHEAP_MODEL=deepseek-r2
BLUXGPT_FAST_MODEL=claude-haiku-4.5

# --- OpenAI (default lane) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- DeepSeek (cheap lane) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-r2

# --- Anthropic (fast/light lane) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Behavior ---
BLUXGPT_STREAM=1
BLUXGPT_CONTEXT_INJECT=1
BLUXGPT_LOG_REQUESTS=1
BLUXGPT_AXIOM_LOGGING=1

