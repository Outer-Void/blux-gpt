# ============================================================
# BluxGPT 2.0 configuration: ~/.config/bluxgpt/.env
# Never commit this file with real keys set.
# Environment variables of the same name override this file.
# ============================================================

# Default logical model for `bluxgpt ask`: blux-main | blux-fast | blux-reason | blux-code
# (1.0 vendor lanes such as gpt-5-mini still work and are mapped, with a notice.)
BLUXGPT_DEFAULT_MODEL=blux-main

# Routing table (blux.model-routes JSON). Empty: the packaged default.
BLUXGPT_ROUTES=

# Provider credentials. Only routes whose provider has a key are usable; the others are skipped
# as PROVIDER_NOT_CONFIGURED and the next route serves the request.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# For a local OpenAI-compatible server (llama.cpp llama-server, vLLM, ...) used by a
# provider "openai-compatible" route with a base_url; usually no key is needed.
OPENAI_COMPATIBLE_API_KEY=

# Behaviour
BLUXGPT_HISTORY=1          # local history in ~/.config/bluxgpt/history.jsonl (0 to keep nothing)
BLUXGPT_CONTEXT=off        # basic: also send platform and BLUX tool versions (never paths or user names)

# Optional developer tool installs during ./install.sh (npm); not needed by BluxGPT.
BLUXGPT_INSTALL_CLAUDE_CODE=0
BLUXGPT_INSTALL_CODEX=0
