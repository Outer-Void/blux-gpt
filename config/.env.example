# ============================================================
# BluxGPT Configuration
# User config: ~/.config/bluxgpt/.env
# Never commit this file with real keys set
# ============================================================

# --- Lane selection ---
# These select which canonical model to use per lane.
# API model names are defined in bluxgpt/core/models.py — not overridable here.
BLUXGPT_DEFAULT_MODEL=gpt-5-mini
BLUXGPT_CHEAP_MODEL=deepseek-chat
BLUXGPT_FAST_MODEL=claude-haiku-4.5
BLUXGPT_REASONING_MODEL=deepseek-reasoner

# --- OpenAI (default lane) ---
OPENAI_API_KEY=

# --- DeepSeek (cheap lane + reasoning lane) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Anthropic (fast/light lane) ---
ANTHROPIC_API_KEY=

# --- Behavior ---
BLUXGPT_CONTEXT_INJECT=1
BLUXGPT_LOG_REQUESTS=1
BLUXGPT_AXIOM_LOGGING=1

# --- Optional developer tool installs (npm-based) ---
# Set to 1 before running install.sh to enable.
# These are not required for core blux functionality.
# Requires Node.js/npm to be installed.
BLUXGPT_INSTALL_CLAUDE_CODE=0
BLUXGPT_INSTALL_CODEX=0
